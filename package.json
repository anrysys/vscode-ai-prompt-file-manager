{
  "name": "text-to-ai-chat",
  "displayName": "AI Prompt File Manager",
  "icon": "icon.png",
  "description": "Store prompts as plain .md/.txt files and insert them into AI chat panels.",
  "publisher": "anrysys",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anrysys/vscode-ai-prompt-file-manager.git"
  },
  "bugs": {
    "url": "https://github.com/anrysys/vscode-ai-prompt-file-manager/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "prompt",
    "snippet",
    "copilot",
    "chat",
    "ai",
    "obsidian"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptManager",
          "title": "AI Prompt File Manager",
          "icon": "resources/prompt-manager.svg"
        }
      ]
    },
    "views": {
      "promptManager": [
        {
          "id": "promptManager.view",
          "name": "AI Prompt File Manager",
          "icon": "resources/prompt-manager.svg",
          "contextualTitle": "AI Prompt File Manager"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptManager.view",
        "contents": "No prompt snippets yet.\n\nSnippets are plain `.md` / `.txt` files on disk — the file system is the single source of truth.\n[New Snippet](command:promptManager.newSnippet)"
      }
    ],
    "commands": [
      {
        "command": "promptManager.insertSnippet",
        "title": "Insert Snippet",
        "category": "AI Prompt File Manager",
        "icon": "$(insert)"
      },
      {
        "command": "promptManager.insertFromTree",
        "title": "Insert This Snippet",
        "category": "AI Prompt File Manager",
        "icon": "$(insert)"
      },
      {
        "command": "promptManager.copyToClipboard",
        "title": "Copy Snippet to Clipboard",
        "category": "AI Prompt File Manager",
        "icon": "$(clippy)"
      },
      {
        "command": "promptManager.openSnippet",
        "title": "Edit Snippet",
        "category": "AI Prompt File Manager",
        "icon": "$(edit)"
      },
      {
        "command": "promptManager.newSnippet",
        "title": "New Snippet...",
        "category": "AI Prompt File Manager",
        "icon": "$(add)"
      },
      {
        "command": "promptManager.newSnippetHere",
        "title": "New Snippet Here...",
        "category": "AI Prompt File Manager",
        "icon": "$(new-file)"
      },
      {
        "command": "promptManager.newFolder",
        "title": "New Folder...",
        "category": "AI Prompt File Manager",
        "icon": "$(new-folder)"
      },
      {
        "command": "promptManager.renameSnippet",
        "title": "Rename...",
        "category": "AI Prompt File Manager"
      },
      {
        "command": "promptManager.deleteSnippet",
        "title": "Delete",
        "category": "AI Prompt File Manager",
        "icon": "$(trash)"
      },
      {
        "command": "promptManager.openInObsidian",
        "title": "Open in Obsidian",
        "category": "AI Prompt File Manager",
        "icon": "$(link-external)"
      },
      {
        "command": "promptManager.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "AI Prompt File Manager"
      },
      {
        "command": "promptManager.refresh",
        "title": "Refresh",
        "category": "AI Prompt File Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "promptManager.openGlobalFolder",
        "title": "Open Global Prompts Folder",
        "category": "AI Prompt File Manager",
        "icon": "$(folder-opened)"
      },
      {
        "command": "promptManager.configureInsertStrategy",
        "title": "Configure Insert Behavior...",
        "category": "AI Prompt File Manager",
        "icon": "$(gear)"
      },
      {
        "command": "promptManager.cutResource",
        "title": "Cut",
        "category": "AI Prompt File Manager"
      },
      {
        "command": "promptManager.copyResource",
        "title": "Copy",
        "category": "AI Prompt File Manager"
      },
      {
        "command": "promptManager.pasteResource",
        "title": "Paste",
        "category": "AI Prompt File Manager"
      },
      {
        "command": "promptManager.duplicateResource",
        "title": "Duplicate",
        "category": "AI Prompt File Manager",
        "icon": "$(files)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "promptManager.insertFromTree",
          "when": "false"
        },
        {
          "command": "promptManager.openSnippet",
          "when": "false"
        },
        {
          "command": "promptManager.newSnippetHere",
          "when": "false"
        },
        {
          "command": "promptManager.newFolder",
          "when": "false"
        },
        {
          "command": "promptManager.renameSnippet",
          "when": "false"
        },
        {
          "command": "promptManager.deleteSnippet",
          "when": "false"
        },
        {
          "command": "promptManager.openInObsidian",
          "when": "false"
        },
        {
          "command": "promptManager.revealInOS",
          "when": "false"
        },
        {
          "command": "promptManager.cutResource",
          "when": "false"
        },
        {
          "command": "promptManager.copyResource",
          "when": "false"
        },
        {
          "command": "promptManager.duplicateResource",
          "when": "false"
        },
        {
          "command": "promptManager.pasteResource",
          "when": "promptManager.clipboardHasItems"
        }
      ],
      "view/title": [
        {
          "command": "promptManager.newSnippet",
          "when": "view == promptManager.view",
          "group": "navigation@1"
        },
        {
          "command": "promptManager.refresh",
          "when": "view == promptManager.view",
          "group": "navigation@2"
        },
        {
          "command": "promptManager.openGlobalFolder",
          "when": "view == promptManager.view",
          "group": "1_config@1"
        },
        {
          "command": "promptManager.configureInsertStrategy",
          "when": "view == promptManager.view",
          "group": "1_config@2"
        }
      ],
      "view/item/context": [
        {
          "command": "promptManager.insertFromTree",
          "when": "view == promptManager.view && viewItem == promptFile",
          "group": "inline@1"
        },
        {
          "command": "promptManager.newSnippetHere",
          "when": "view == promptManager.view && viewItem =~ /^prompt(Root\\.(global|workspace)|Folder)$/",
          "group": "inline@1"
        },
        {
          "command": "promptManager.insertFromTree",
          "when": "view == promptManager.view && viewItem == promptFile",
          "group": "1_insert@1"
        },
        {
          "command": "promptManager.copyToClipboard",
          "when": "view == promptManager.view && viewItem == promptFile",
          "group": "1_insert@2"
        },
        {
          "command": "promptManager.newSnippetHere",
          "when": "view == promptManager.view && viewItem =~ /^prompt(Root\\.(global|workspace)|Folder)$/",
          "group": "2_create@1"
        },
        {
          "command": "promptManager.newFolder",
          "when": "view == promptManager.view && viewItem =~ /^prompt(Root\\.(global|workspace)|Folder)$/",
          "group": "2_create@2"
        },
        {
          "command": "promptManager.openSnippet",
          "when": "view == promptManager.view && viewItem == promptFile",
          "group": "3_open@1"
        },
        {
          "command": "promptManager.openInObsidian",
          "when": "view == promptManager.view && viewItem == promptFile",
          "group": "3_open@2"
        },
        {
          "command": "promptManager.revealInOS",
          "when": "view == promptManager.view && viewItem =~ /^prompt(File|Folder|Root\\.(global|workspace))$/",
          "group": "3_open@3"
        },
        {
          "command": "promptManager.renameSnippet",
          "when": "view == promptManager.view && viewItem =~ /^prompt(File|Folder)$/",
          "group": "7_modification@1"
        },
        {
          "command": "promptManager.deleteSnippet",
          "when": "view == promptManager.view && viewItem =~ /^prompt(File|Folder)$/",
          "group": "7_modification@2"
        },
        {
          "command": "promptManager.cutResource",
          "when": "view == promptManager.view && viewItem =~ /^prompt(File|Folder)$/",
          "group": "6_cutcopypaste@1"
        },
        {
          "command": "promptManager.copyResource",
          "when": "view == promptManager.view && viewItem =~ /^prompt(File|Folder)$/",
          "group": "6_cutcopypaste@2"
        },
        {
          "command": "promptManager.pasteResource",
          "when": "view == promptManager.view && viewItem =~ /^prompt(Root\\.(global|workspace)|Folder|File)$/ && promptManager.clipboardHasItems",
          "group": "6_cutcopypaste@3"
        },
        {
          "command": "promptManager.duplicateResource",
          "when": "view == promptManager.view && viewItem =~ /^prompt(File|Folder)$/",
          "group": "6_cutcopypaste@4"
        }
      ],
      "explorer/context": [
        {
          "command": "promptManager.openInObsidian",
          "when": "resourceExtname == .md",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "promptManager.insertSnippet",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "promptManager.copyResource",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == promptManager.view"
      },
      {
        "command": "promptManager.cutResource",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == promptManager.view"
      },
      {
        "command": "promptManager.pasteResource",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == promptManager.view && promptManager.clipboardHasItems"
      },
      {
        "command": "promptManager.renameSnippet",
        "key": "f2",
        "when": "focusedView == promptManager.view"
      },
      {
        "command": "promptManager.deleteSnippet",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == promptManager.view"
      }
    ],
    "configuration": {
      "title": "AI Prompt File Manager",
      "properties": {
        "promptManager.global.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show the Global Prompts scope."
        },
        "promptManager.global.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Folder holding global prompt snippets. Supports `~`, `${userHome}` and `${env:NAME}`. When empty, the extension's own global storage folder is used.\n\nExample: `~/Documents/Obsidian Vault/Prompts`"
        },
        "promptManager.workspace.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show the Workspace Prompts scope."
        },
        "promptManager.workspace.path": {
          "type": "string",
          "default": ".vscode/prompts",
          "scope": "resource",
          "markdownDescription": "Folder holding workspace prompt snippets, relative to each workspace folder. Absolute paths are also accepted. Supports `${workspaceFolder}`."
        },
        "promptManager.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".md",
            ".txt"
          ],
          "scope": "window",
          "description": "File extensions treated as prompt snippets."
        },
        "promptManager.newSnippet.extension": {
          "type": "string",
          "enum": [
            ".md",
            ".txt"
          ],
          "default": ".md",
          "scope": "window",
          "description": "Extension used when creating a new snippet."
        },
        "promptManager.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/.obsidian/**"
          ],
          "scope": "window",
          "description": "Subfolders skipped when scanning snippet directories."
        },
        "promptManager.maxDepth": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 32,
          "scope": "window",
          "description": "Maximum subfolder nesting depth to scan."
        },
        "promptManager.maxFileSizeKb": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "scope": "window",
          "description": "Refuse to read snippet files larger than this size, in KB."
        },
        "promptManager.quickPick.showPreview": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Read the highlighted snippet on demand to show a short preview in the Quick Pick."
        },
        "promptManager.quickPick.frequentCount": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 20,
          "scope": "window",
          "description": "How many of your most-used snippets to list under \"Frequently used\" at the top of the Quick Pick. Set to 0 to hide the group."
        },
        "promptManager.insert.pasteIntoChatPanel": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Attempts to pre-fill the VS Code Copilot / Quick Chat input box.\n\nThe text is placed in the input without being submitted, so you can still edit it. Chat panels that render as webviews — Claude Code, Antigravity and similar — cannot be typed into by any extension; for those, the snippet stays on the clipboard and `#promptManager.insert.focusCommand#` can focus the input so `Ctrl+V` is one keystroke away."
        },
        "promptManager.insert.pasteIntoEditor": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "⚠️ **Warning:** If enabled, this replaces the currently selected text in your active code editor.\n\nLeave this off unless you actually want prompts written into your files. A snippet that quotes `{{selection}}` is never written back over that selection even with this on — the snippet stays on the clipboard instead, and the status bar says why."
        },
        "promptManager.insert.strategy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDeprecationMessage": "**Deprecated.** Use `#promptManager.insert.pasteIntoChatPanel#` and `#promptManager.insert.pasteIntoEditor#` instead. A value set here still wins, so nothing changes until you remove it; running **AI Prompt File Manager: Configure Insert Behavior...** clears it for you.",
          "markdownDescription": "Ordered list of raw command ids tried after the snippet is copied. Superseded by the two toggles above, which cover the same ground without asking you to know which command ids carry text and which write into your code."
        },
        "promptManager.insert.focusCommand": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Command run after copying when no insert strategy succeeded, to focus the chat input so you can press `Ctrl+V`. Examples: `claude-vscode.focus`, `antigravity.panel.focus`, `workbench.panel.chat.view.copilot.focus`."
        },
        "promptManager.insert.treatAsSnippet": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "When inserting into a text editor, interpret `$1` / `${1:name}` as snippet tabstops. Leave this off if your prompts contain a literal `$`, `{` or `}`. This applies to macro-expanded content too: text pulled in by `{{selection}}` or `{{clipboard}}` is interpreted the same way."
        },
        "promptManager.insert.notification": {
          "type": "string",
          "enum": [
            "statusBar",
            "toast",
            "none"
          ],
          "enumDescriptions": [
            "Brief status bar message",
            "Information notification",
            "No feedback"
          ],
          "default": "statusBar",
          "scope": "window",
          "description": "How to confirm that a snippet was copied or inserted."
        },
        "promptManager.macros.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Expand macros in snippet text before inserting or copying. The snippet file on disk is never modified.\n- `{{selection}}` — text selected in the active editor, or empty\n- `{{active_file}}` — file name of the active editor, for example `extension.ts`\n- `{{clipboard}}` — the current clipboard contents\n\nInteractive variables ask you for a value as the snippet is inserted:\n- `{{?Language}}` — an input box\n- `{{?Language=Rust}}` — an input box, pre-filled\n- `{{?Language:Rust|Go|Python}}` — a list to pick from\n\nPressing `Esc` at any point cancels the whole insert and leaves your clipboard untouched.\n\nAnything else in double braces, such as `{{foo}}`, is left exactly as written. Put a backslash in front to show a macro without expanding it: `\\{{selection}}`."
        },
        "promptManager.obsidian.uriTemplate": {
          "type": "string",
          "default": "obsidian://open?path={absolutePath}",
          "scope": "window",
          "markdownDescription": "URI used by **Open in Obsidian**. Placeholders are substituted URL-encoded:\n- `{absolutePath}` — full path of the snippet file\n- `{relativePath}` — path relative to its prompt root\n- `{vault}` — the value of `#promptManager.obsidian.vaultName#`\n\nTo address a file inside a named vault instead, use:\n`obsidian://open?vault={vault}&file={relativePath}`"
        },
        "promptManager.obsidian.vaultName": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Obsidian vault name substituted for `{vault}` in `#promptManager.obsidian.uriTemplate#`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.1",
    "eslint": "^9.23.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2"
  }
}
